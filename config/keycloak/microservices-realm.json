      "firstName": "Admin",
      "lastName": "Sistema",
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "Admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["USER", "ADMIN"]
    }
  ]
}
