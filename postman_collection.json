		{
			"name": "Passo 7 - Criar Pedido (fluxo completo)",
			"description": "Requer token JWT. Faca login na pasta '0 - Autenticacao' antes de executar.",
			"item": [
				{
					"name": "Criar Pedido",
					"request": {
						"method": "POST",
						"url": "{{baseUrl}}/vendas/pedidos",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"items\": [\n    {\n      \"sku\": \"ABC-123\",\n      \"quantidade\": 2,\n      \"valor\": 199.90\n    }\n  ],\n  \"cepDestino\": \"01310-100\"\n}"
						},
						"description": "Fluxo principal: vendas-service orquestra estoque -> frete -> pagamento. Copie o pedidoId da resposta para as variaveis de colecao."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.pedidoId) {",
									"    pm.collectionVariables.set('pedidoId', jsonData.pedidoId);",
									"    console.log('pedidoId salvo: ' + jsonData.pedidoId);",
									"}",
									"if (jsonData.items && jsonData.items.length > 0) {",
									"    var firstItem = jsonData.items[0];",
									"    if (firstItem.reservaId) {",
									"        pm.collectionVariables.set('reservaId', firstItem.reservaId);",
									"        console.log('reservaId salvo: ' + firstItem.reservaId);",
									"    }",
									"    if (firstItem.freteId) {",
									"        pm.collectionVariables.set('freteId', firstItem.freteId);",
									"        console.log('freteId salvo: ' + firstItem.freteId);",
									"    }",
									"}"
								]
							}
						}
					]
				}
			]
		},
		{
